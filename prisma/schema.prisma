generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RawOrder {
  id                     String    @id @default(cuid())
  shopifyOrderId         String    @unique @map("shopify_order_id")
  orderName              String    @map("order_name")
  orderDate              DateTime  @map("order_date") @db.Date
  financialStatus        String?   @map("financial_status")
  fulfillmentStatus      String?   @map("fulfillment_status")
  fulfillmentDate        DateTime? @map("fulfillment_date") @db.Date
  deliveryStatus         String?   @map("delivery_status")
  deliveryDate           DateTime? @map("delivery_date") @db.Date
  grossSales             Decimal   @map("gross_sales") @db.Decimal(18, 4)
  discounts              Decimal   @db.Decimal(18, 4)
  shippingCharged        Decimal   @map("shipping_charged") @db.Decimal(18, 4)
  salesTax               Decimal   @map("sales_tax") @db.Decimal(18, 4)
  orderTotalBeforeRefund Decimal   @map("order_total_before_refund") @db.Decimal(18, 4)
  orderTotal             Decimal   @map("order_total") @db.Decimal(18, 4)
  refundAmount           Decimal   @map("refund_amount") @db.Decimal(18, 4)
  calcOrderNetAfterRefund Decimal  @map("calc_order_net_after_refund") @db.Decimal(18, 4)
  refundDate             DateTime? @map("refund_date") @db.Date
  items                  Int
  tag                    String?
  syncedAt               DateTime  @default(now()) @map("synced_at")

  @@index([orderDate])
  @@map("raw_orders")
}

model ShopifySyncRun {
  id           String    @id @default(cuid())
  status       String
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")
  pageCount    Int       @default(0) @map("page_count")
  addedCount   Int       @default(0) @map("added_count")
  skippedCount Int       @default(0) @map("skipped_count")
  errorMessage String?   @map("error_message") @db.Text

  @@index([startedAt])
  @@map("shopify_sync_runs")
}

model CogsRecord {
  id               String   @id @default(cuid())
  supplier         String
  date             DateTime @db.Date
  referenceOrderId String?  @map("reference_order_id")
  supplierOrderId  String?  @map("supplier_order_id")
  totalCost        Decimal  @map("total_cost") @db.Decimal(18, 4)
  estimatedCost    Decimal  @map("estimated_cost") @db.Decimal(18, 4)
  itemKey          String   @unique @map("item_key")
  sourceRecordId   String?  @map("source_record_id")
  mappingStatus    String   @default("MATCHED") @map("mapping_status")
  sourceNote       String?  @map("source_note") @db.Text
  rawPayload       Json?    @map("raw_payload")
  syncedAt         DateTime @default(now()) @map("synced_at")

  @@index([date])
  @@index([supplier, date])
  @@map("cogs_records")
}

model CogsSourceRecord {
  id         String    @id @default(cuid())
  supplier   String
  externalId String    @map("external_id")
  payload    Json
  sourceDate DateTime? @map("source_date") @db.Date
  syncedAt   DateTime  @default(now()) @map("synced_at")

  @@unique([supplier, externalId])
  @@index([supplier, sourceDate])
  @@map("cogs_source_records")
}

model CogsSyncRun {
  id            String    @id @default(cuid())
  status        String
  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  sourceResults Json?     @map("source_results")
  addedCount    Int       @default(0) @map("added_count")
  skippedCount  Int       @default(0) @map("skipped_count")
  errorMessage  String?   @map("error_message") @db.Text

  @@index([startedAt])
  @@map("cogs_sync_runs")
}

model ShopifyPaymentRecord {
  id              String    @id @default(cuid())
  externalId      String    @unique @map("external_id")
  recordType      String    @map("record_type")
  transactionDate DateTime? @map("transaction_date")
  currency        String?
  grossAmount     Decimal?  @map("gross_amount") @db.Decimal(18, 4)
  feeAmount       Decimal?  @map("fee_amount") @db.Decimal(18, 4)
  netAmount       Decimal?  @map("net_amount") @db.Decimal(18, 4)
  payoutId        String?   @map("payout_id")
  payoutStatus    String?   @map("payout_status")
  sourceType      String?   @map("source_type")
  sourceOrderId   String?   @map("source_order_id")
  sourceOrderName String?   @map("source_order_name")
  reason          String?
  payload         Json
  syncedAt        DateTime  @default(now()) @map("synced_at")

  @@index([recordType, transactionDate])
  @@index([payoutId])
  @@map("shopify_payment_records")
}

model ShopifyPaymentSyncRun {
  id           String    @id @default(cuid())
  status       String
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")
  addedCount   Int       @default(0) @map("added_count")
  skippedCount Int       @default(0) @map("skipped_count")
  errorMessage String?   @map("error_message") @db.Text

  @@index([startedAt])
  @@map("shopify_payment_sync_runs")
}

model MetaDailyFinancial {
  id               String   @id @default(cuid())
  accountId        String   @map("account_id")
  dateStart        DateTime @map("date_start") @db.Date
  dateStop         DateTime @map("date_stop") @db.Date
  currency         String?
  spend            Decimal  @db.Decimal(18, 4)
  purchaseCount    Decimal  @map("purchase_count") @db.Decimal(18, 4)
  purchaseValue    Decimal  @map("purchase_value") @db.Decimal(18, 4)
  purchaseRoas     Decimal  @map("purchase_roas") @db.Decimal(18, 6)
  costPerPurchase Decimal  @map("cost_per_purchase") @db.Decimal(18, 6)
  impressions      BigInt
  clicks           BigInt
  cpc              Decimal  @db.Decimal(18, 6)
  cpm              Decimal  @db.Decimal(18, 6)
  ctr              Decimal  @db.Decimal(18, 6)
  rawPayload       Json     @map("raw_payload")
  syncedAt         DateTime @default(now()) @map("synced_at")

  @@unique([accountId, dateStart])
  @@index([dateStart])
  @@map("meta_daily_financials")
}

model AirwallexAccountActivity {
  id              String   @id @default(cuid())
  externalId      String   @unique @map("external_id")
  transactionDate DateTime @map("transaction_date")
  transactionType String   @map("transaction_type")
  card            String?
  cardNickName    String?  @map("card_nick_name")
  accountNumber   String?  @map("account_number")
  accountName     String?  @map("account_name")
  wherePaid       String?  @map("where_paid")
  credit          Decimal  @db.Decimal(18, 4)
  debit           Decimal  @db.Decimal(18, 4)
  currency        String?
  ledgerStatus    String   @default("Posted") @map("ledger_status")
  details         String?  @db.Text
  rawPayload      Json     @map("raw_payload")
  syncedAt        DateTime @default(now()) @map("synced_at")

  @@index([transactionDate])
  @@index([card])
  @@map("airwallex_account_activity")
}

model User {
  id           String         @id @default(cuid())
  name         String         @db.VarChar(100)
  email        String         @unique @db.VarChar(254)
  role         String         @default("admin") @db.VarChar(50)
  passwordHash String         @map("password_hash") @db.Text
  active       Boolean        @default(true)
  team         String         @default("maturex") @db.VarChar(100)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model EtsyShop {
  id            String            @id @default(cuid())
  code          String            @unique @db.VarChar(50)
  name          String            @db.VarChar(100)
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  importBatches EtsyImportBatch[]
  orders        EtsyOrder[]
  orderItems    EtsyOrderItem[]
  statements    EtsyStatement[]

  @@map("etsy_shops")
}

model EtsyImportBatch {
  id             String          @id @default(cuid())
  shopId         String          @map("shop_id")
  shop           EtsyShop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  reportType     String          @map("report_type") @db.VarChar(50)
  sourceFileName String          @map("source_file_name") @db.Text
  sourceMonth    DateTime        @map("source_month") @db.Date
  fileHash       String          @map("file_hash") @db.VarChar(64)
  status         String          @default("PROCESSING") @db.VarChar(30)
  totalRows      Int             @default(0) @map("total_rows")
  insertedRows   Int             @default(0) @map("inserted_rows")
  updatedRows    Int             @default(0) @map("updated_rows")
  skippedRows    Int             @default(0) @map("skipped_rows")
  failedRows     Int             @default(0) @map("failed_rows")
  errorDetails   Json?           @map("error_details")
  startedAt      DateTime        @default(now()) @map("started_at")
  completedAt    DateTime?       @map("completed_at")
  orders         EtsyOrder[]
  orderItems     EtsyOrderItem[]
  statements     EtsyStatement[]

  @@unique([shopId, reportType, fileHash])
  @@index([shopId, sourceMonth])
  @@index([status, startedAt])
  @@map("etsy_import_batches")
}

model EtsyOrder {
  id                         String          @id @default(cuid())
  shopId                     String          @map("shop_id")
  shop                       EtsyShop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  importBatchId              String          @map("import_batch_id")
  importBatch                EtsyImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  orderId                    String          @map("order_id") @db.VarChar(100)
  saleDate                   DateTime        @map("sale_date") @db.Date
  buyerUserId                String?         @map("buyer_user_id") @db.Text
  fullName                   String?         @map("full_name") @db.Text
  firstName                  String?         @map("first_name") @db.Text
  lastName                   String?         @map("last_name") @db.Text
  numberOfItems              Int?            @map("number_of_items")
  paymentMethod              String?         @map("payment_method") @db.Text
  dateShipped                DateTime?       @map("date_shipped") @db.Date
  street1                    String?         @map("street_1") @db.Text
  street2                    String?         @map("street_2") @db.Text
  shipCity                   String?         @map("ship_city") @db.Text
  shipState                  String?         @map("ship_state") @db.Text
  shipZipcode                String?         @map("ship_zipcode") @db.Text
  shipCountry                String?         @map("ship_country") @db.Text
  currency                   String?         @db.VarChar(10)
  orderValue                 Decimal?        @map("order_value") @db.Decimal(18, 4)
  couponCode                 String?         @map("coupon_code") @db.Text
  couponDetails              String?         @map("coupon_details") @db.Text
  discountAmount             Decimal?        @map("discount_amount") @db.Decimal(18, 4)
  shippingDiscount           Decimal?        @map("shipping_discount") @db.Decimal(18, 4)
  shipping                   Decimal?        @db.Decimal(18, 4)
  salesTax                   Decimal?        @map("sales_tax") @db.Decimal(18, 4)
  orderTotal                 Decimal?        @map("order_total") @db.Decimal(18, 4)
  status                     String?         @db.Text
  cardProcessingFees         Decimal?        @map("card_processing_fees") @db.Decimal(18, 4)
  orderNet                   Decimal?        @map("order_net") @db.Decimal(18, 4)
  adjustedOrderTotal         Decimal?        @map("adjusted_order_total") @db.Decimal(18, 4)
  adjustedCardProcessingFees Decimal?        @map("adjusted_card_processing_fees") @db.Decimal(18, 4)
  adjustedNetOrderAmount     Decimal?        @map("adjusted_net_order_amount") @db.Decimal(18, 4)
  buyer                      String?         @db.Text
  orderType                  String?         @map("order_type") @db.Text
  paymentType                String?         @map("payment_type") @db.Text
  inPersonDiscount           Decimal?        @map("in_person_discount") @db.Decimal(18, 4)
  inPersonLocation           String?         @map("in_person_location") @db.Text
  sku                        String?         @db.Text
  rawPayload                 Json            @map("raw_payload")
  createdAt                  DateTime        @default(now()) @map("created_at")
  updatedAt                  DateTime        @updatedAt @map("updated_at")
  orderItems                 EtsyOrderItem[]

  @@unique([shopId, orderId])
  @@index([shopId, saleDate])
  @@index([importBatchId])
  @@map("etsy_orders")
}

model EtsyOrderItem {
  id               String          @id @default(cuid())
  shopId           String          @map("shop_id")
  shop             EtsyShop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  importBatchId    String          @map("import_batch_id")
  importBatch      EtsyImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  etsyOrderId      String?         @map("etsy_order_id")
  etsyOrder        EtsyOrder?      @relation(fields: [etsyOrderId], references: [id], onDelete: SetNull)
  orderId          String          @map("order_id") @db.VarChar(100)
  sourceKey        String          @map("source_key") @db.VarChar(64)
  transactionId    String?         @map("transaction_id") @db.VarChar(100)
  listingId        String?         @map("listing_id") @db.VarChar(100)
  saleDate         DateTime        @map("sale_date") @db.Date
  itemName         String?         @map("item_name") @db.Text
  buyer            String?         @db.Text
  quantity         Int?
  price            Decimal?        @db.Decimal(18, 4)
  couponCode       String?         @map("coupon_code") @db.Text
  couponDetails    String?         @map("coupon_details") @db.Text
  discountAmount   Decimal?        @map("discount_amount") @db.Decimal(18, 4)
  shippingDiscount Decimal?        @map("shipping_discount") @db.Decimal(18, 4)
  orderShipping    Decimal?        @map("order_shipping") @db.Decimal(18, 4)
  orderSalesTax    Decimal?        @map("order_sales_tax") @db.Decimal(18, 4)
  itemTotal        Decimal?        @map("item_total") @db.Decimal(18, 4)
  currency         String?         @db.VarChar(10)
  datePaid         DateTime?       @map("date_paid") @db.Date
  dateShipped      DateTime?       @map("date_shipped") @db.Date
  shipName         String?         @map("ship_name") @db.Text
  shipAddress1     String?         @map("ship_address_1") @db.Text
  shipAddress2     String?         @map("ship_address_2") @db.Text
  shipCity         String?         @map("ship_city") @db.Text
  shipState        String?         @map("ship_state") @db.Text
  shipZipcode      String?         @map("ship_zipcode") @db.Text
  shipCountry      String?         @map("ship_country") @db.Text
  variations       String?         @db.Text
  orderType        String?         @map("order_type") @db.Text
  listingsType     String?         @map("listings_type") @db.Text
  paymentType      String?         @map("payment_type") @db.Text
  inPersonDiscount Decimal?        @map("in_person_discount") @db.Decimal(18, 4)
  inPersonLocation String?         @map("in_person_location") @db.Text
  vatPaidByBuyer   Decimal?        @map("vat_paid_by_buyer") @db.Decimal(18, 4)
  sku              String?         @db.Text
  matchStatus      String          @default("MATCHED") @map("match_status") @db.VarChar(30)
  rawPayload       Json            @map("raw_payload")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@unique([shopId, sourceKey])
  @@index([shopId, saleDate])
  @@index([orderId])
  @@index([etsyOrderId])
  @@index([importBatchId])
  @@map("etsy_order_items")
}

model EtsyStatement {
  id               String          @id @default(cuid())
  shopId           String          @map("shop_id")
  shop             EtsyShop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  importBatchId    String          @map("import_batch_id")
  importBatch      EtsyImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  sourceKey        String          @map("source_key") @db.VarChar(64)
  statementDate    DateTime        @map("statement_date") @db.Date
  type             String          @db.VarChar(50)
  title            String?         @db.Text
  info             String?         @db.Text
  currency         String?         @db.VarChar(10)
  amount           Decimal?        @db.Decimal(18, 4)
  feesAndTaxes     Decimal?        @map("fees_and_taxes") @db.Decimal(18, 4)
  net              Decimal?        @db.Decimal(18, 4)
  taxDetails       String?         @map("tax_details") @db.Text
  extractedOrderId String?         @map("extracted_order_id") @db.VarChar(100)
  rawPayload       Json            @map("raw_payload")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@unique([shopId, sourceKey])
  @@index([shopId, statementDate])
  @@index([shopId, type, statementDate])
  @@index([extractedOrderId])
  @@index([importBatchId])
  @@map("etsy_statements")
}
